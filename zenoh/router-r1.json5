{
  // Zenoh router node R1 (mesh member).
  // For a real multi-PC deployment: replace zenoh-r2/zenoh-r3 with the other
  // machines' IPs (e.g. tcp/192.168.1.12:7447) and run only this router on PC1.
  mode: "router",
  connect: {
    endpoints: ["tcp/zenoh-r2:7447", "tcp/zenoh-r3:7447"],
  },
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },
  scouting: {
    // Explicit peering is used instead of multicast for cross-host reliability.
    multicast: { enabled: false },
    gossip: { enabled: true },
  },
  plugins: {
    rest: { http_port: 8000 },
  },
}
